@page "/projects/{ProjectId:guid}/step/{Step:int}"
@inject IProjectService ProjectService
@inject IGeneralInfoService GeneralInfoService
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>@(project?.InternalName ?? "Dự án") · Polygon AI Builder</PageTitle>

@if (isLoading)
{
    <div class="loading-card"><span class="spinner-border spinner-border-sm"></span> Đang mở dự án…</div>
}
else if (project is null)
{
    <section class="panel empty-state">
        <h1>Không tìm thấy dự án</h1>
        <p>Dự án có thể đã bị xóa hoặc địa chỉ không hợp lệ.</p>
        <a class="btn btn-primary" href="/">Về dashboard</a>
    </section>
}
else
{
    <header class="wizard-title-row">
        <div>
            <a class="back-link" href="/">← Tất cả dự án</a>
            <h1>@project.InternalName</h1>
        </div>
        <div class="autosave-indicator @autosaveClass"><span class="status-dot"></span> @autosaveText</div>
    </header>

    <nav class="wizard-progress panel" aria-label="Tiến trình tạo problem">
        @for (var index = 1; index <= Steps.Length; index++)
        {
            var captured = index;
            <button class="wizard-step @(captured == Step ? "active" : "") @(captured < Step ? "complete" : "")"
                    @onclick="() => NavigateToStepAsync(captured)" aria-current="@(captured == Step ? "step" : null)">
                <span>@(captured < Step ? "✓" : captured)</span>
                <small>@Steps[captured - 1]</small>
            </button>
        }
    </nav>

    <section class="wizard-content panel">
        <div class="step-intro">
            <span class="step-kicker">Bước @Step / 5</span>
            <h2>@Steps[Step - 1]</h2>
            <p>@GetStepDescription(Step)</p>
        </div>

        @if (Step == 1)
        {
            <div class="general-info-grid" aria-label="General Info">
                <label for="internal-name">
                    <span>Polygon internal problem name</span>
                    <input id="internal-name" class="form-control @(HasIssue("InternalName") ? "is-invalid" : "")"
                           maxlength="128" autocomplete="off" @bind="internalName" @bind:event="oninput"
                           @bind:after="QueueAutosaveAsync" disabled="@isNavigating" />
                    @if (GetIssue("InternalName") is { } internalNameIssue)
                    {
                        <small class="field-error">@internalNameIssue</small>
                    }
                </label>
                <label for="input-file">
                    <span>Input file</span>
                    <input id="input-file" class="form-control @(HasIssue("InputFile") ? "is-invalid" : "")"
                           maxlength="64" @bind="inputFile" @bind:event="oninput"
                           @bind:after="QueueAutosaveAsync" disabled="@isNavigating" />
                    @if (GetIssue("InputFile") is { } inputIssue)
                    {
                        <small class="field-error">@inputIssue</small>
                    }
                </label>
                <label for="output-file">
                    <span>Output file</span>
                    <input id="output-file" class="form-control @(HasIssue("OutputFile") ? "is-invalid" : "")"
                           maxlength="64" @bind="outputFile" @bind:event="oninput"
                           @bind:after="QueueAutosaveAsync" disabled="@isNavigating" />
                    @if (GetIssue("OutputFile") is { } outputIssue)
                    {
                        <small class="field-error">@outputIssue</small>
                    }
                </label>
                <label for="time-limit">
                    <span>Time limit</span>
                    <div class="input-suffix">
                        <input id="time-limit" type="number" min="250" max="15000" step="50"
                               class="form-control @(HasIssue("TimeLimitMs") ? "is-invalid" : "")"
                               @bind="timeLimitMs" @bind:event="oninput" @bind:after="QueueAutosaveAsync"
                               disabled="@isNavigating" />
                        <span>ms</span>
                    </div>
                    <small>250–15.000 ms, chia hết cho 50</small>
                    @if (GetIssue("TimeLimitMs") is { } timeIssue)
                    {
                        <small class="field-error">@timeIssue</small>
                    }
                </label>
                <label for="memory-limit">
                    <span>Memory limit</span>
                    <div class="input-suffix">
                        <input id="memory-limit" type="number" min="4" max="1024" step="1"
                               class="form-control @(HasIssue("MemoryLimitMb") ? "is-invalid" : "")"
                               @bind="memoryLimitMb" @bind:event="oninput" @bind:after="QueueAutosaveAsync"
                               disabled="@isNavigating" />
                        <span>MB</span>
                    </div>
                    <small>4–1.024 MB</small>
                    @if (GetIssue("MemoryLimitMb") is { } memoryIssue)
                    {
                        <small class="field-error">@memoryIssue</small>
                    }
                </label>
            </div>
            @if (!string.IsNullOrWhiteSpace(workflowMessage))
            {
                <div class="notice @workflowNoticeClass" role="status">@workflowMessage</div>
            }
            else
            {
                <div class="notice notice-info">Nút Tiếp theo chỉ gọi <code>problems.list</code> để kiểm tra tên. Problem trên Polygon chưa được tạo ở bước này.</div>
            }
        }
        else if (Step == 2)
        {
            <AiWorkspace ProjectId="ProjectId" />
        }
        else if (Step == 3)
        {
            <StatementEditor @ref="statementEditor" ProjectId="ProjectId" />
            @if (!string.IsNullOrWhiteSpace(statementContinueMessage))
            {
                <div class="notice notice-error statement-continue-notice" role="alert">@statementContinueMessage</div>
            }
        }
        else
        {
            <div class="phase-placeholder">
                <span aria-hidden="true">◇</span>
                <h3>@GetPlaceholderTitle(Step)</h3>
                <p>Shell điều hướng và trạng thái dự án đã sẵn sàng; nội dung chức năng được triển khai ở phase tương ứng trong plan.</p>
            </div>
        }
    </section>

    <footer class="wizard-footer">
        <button class="btn btn-ghost" @onclick="PreviousAsync" disabled="@(Step == 1 || isNavigating)">← Quay lại</button>
        <span>Bước hiện tại được lưu để mở lại đúng vị trí.</span>
        <button class="btn btn-primary app-primary" @onclick="NextAsync" disabled="@(Step == 5 || isNavigating)">Tiếp theo →</button>
    </footer>
}

@code {
    [Parameter] public Guid ProjectId { get; set; }
    [Parameter] public int Step { get; set; }

    private static readonly string[] Steps = ["General Info", "AI Workspace", "Statement", "Code", "Tests & Sync"];
    private ProjectDetails? project;
    private string internalName = string.Empty;
    private string inputFile = "stdin";
    private string outputFile = "stdout";
    private int timeLimitMs = 1000;
    private int memoryLimitMb = 256;
    private IReadOnlyList<ValidationIssue> validationIssues = [];
    private CancellationTokenSource? autosaveCancellation;
    private string autosaveText = "Đã lưu local";
    private string autosaveClass = "saved";
    private string? workflowMessage;
    private string workflowNoticeClass = "notice-info";
    private bool isLoading = true;
    private bool isNavigating;
    private StatementEditor? statementEditor;
    private string? statementContinueMessage;

    protected override async Task OnParametersSetAsync()
    {
        // Navigation reuses this routed component, so clear the transition flag for the new step.
        isNavigating = false;
        if (Step is < 1 or > 5)
        {
            Navigation.NavigateTo($"/projects/{ProjectId}/step/1", replace: true);
            return;
        }

        isLoading = true;
        project = await ProjectService.GetAsync(ProjectId);
        if (project is not null)
        {
            internalName = project.InternalName;
            inputFile = project.InputFile;
            outputFile = project.OutputFile;
            timeLimitMs = project.TimeLimitMs;
            memoryLimitMb = project.MemoryLimitMb;
        }

        if (project is not null
            && Step > 1
            && project.NameAvailableCheckedAt is null
            && project.PolygonProblemId is null)
        {
            await ProjectService.SetCurrentScreenAsync(ProjectId, 1);
            isLoading = false;
            Navigation.NavigateTo($"/projects/{ProjectId}/step/1", replace: true);
            return;
        }

        if (project is not null && project.CurrentScreen != Step)
        {
            await ProjectService.SetCurrentScreenAsync(ProjectId, Step);
            project = project with { CurrentScreen = Step };
        }

        isLoading = false;
    }

    private Task PreviousAsync() => NavigateToStepAsync(Step - 1);
    private Task NextAsync() => Step switch
    {
        1 => CheckNameAndContinueAsync(),
        3 => ValidateStatementAndContinueAsync(),
        _ => NavigateToStepAsync(Step + 1),
    };

    private async Task ValidateStatementAndContinueAsync()
    {
        if (statementEditor is null)
        {
            return;
        }

        isNavigating = true;
        try
        {
            var result = await statementEditor.SaveNowAsync();
            if (!result.CanContinue)
            {
                var missing = new[]
                {
                    ("Title", result.Statement?.Content.Title),
                    ("Legend", result.Statement?.Content.Legend),
                    ("Input", result.Statement?.Content.Input),
                    ("Output", result.Statement?.Content.Output),
                }.Where(item => string.IsNullOrWhiteSpace(item.Item2)).Select(item => item.Item1).ToArray();
                statementContinueMessage = missing.Length > 0
                    ? $"Chưa thể tiếp tục: các trường bắt buộc còn trống: {string.Join(", ", missing)}."
                    : "Chưa thể tiếp tục: hãy sửa các lỗi LaTeX màu đỏ.";
                return;
            }

            statementContinueMessage = null;
            await ProjectService.SetCurrentScreenAsync(ProjectId, 4);
            Navigation.NavigateTo($"/projects/{ProjectId}/step/4");
        }
        finally
        {
            isNavigating = false;
        }
    }

    private async Task NavigateToStepAsync(int target)
    {
        if (target is < 1 or > 5 || target == Step)
        {
            return;
        }

        if (Step == 1 && target > 1)
        {
            await CheckNameAndContinueAsync();
            return;
        }

        isNavigating = true;
        await ProjectService.SetCurrentScreenAsync(ProjectId, target);
        Navigation.NavigateTo($"/projects/{ProjectId}/step/{target}");
    }

    private Task QueueAutosaveAsync()
    {
        autosaveCancellation?.Cancel();
        autosaveCancellation?.Dispose();
        autosaveCancellation = new CancellationTokenSource();
        autosaveText = "Chưa lưu";
        autosaveClass = "pending";
        workflowMessage = null;
        _ = AutosaveAfterDelayAsync(autosaveCancellation.Token);
        return Task.CompletedTask;
    }

    private async Task AutosaveAfterDelayAsync(CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(500, cancellationToken);
            await SaveDraftAsync(showSavedMessage: false, cancellationToken);
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            return;
        }
        catch (Exception)
        {
            autosaveText = "Lưu thất bại";
            autosaveClass = "failed";
            workflowMessage = "Không thể autosave. Dữ liệu trên màn hình vẫn được giữ; hãy thử lại.";
            workflowNoticeClass = "notice-error";
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task<bool> SaveDraftAsync(bool showSavedMessage, CancellationToken cancellationToken)
    {
        var result = await GeneralInfoService.SaveGeneralInfoAsync(ProjectId, CreateDraft(), cancellationToken);
        validationIssues = result.Issues;
        if (!result.Succeeded || result.Project is null)
        {
            autosaveText = "Chưa hợp lệ";
            autosaveClass = "failed";
            return false;
        }

        project = result.Project;
        internalName = result.Project.InternalName;
        inputFile = result.Project.InputFile;
        outputFile = result.Project.OutputFile;
        autosaveText = "Đã lưu local";
        autosaveClass = "saved";
        if (showSavedMessage)
        {
            workflowMessage = "Đã lưu General Info trên máy này.";
            workflowNoticeClass = "notice-success";
        }

        return true;
    }

    private async Task CheckNameAndContinueAsync()
    {
        autosaveCancellation?.Cancel();
        isNavigating = true;
        workflowMessage = "Đang kiểm tra tên bằng Polygon API…";
        workflowNoticeClass = "notice-info";
        try
        {
            var result = await GeneralInfoService.CheckNameAndContinueAsync(ProjectId, CreateDraft());
            validationIssues = result.Issues;
            workflowMessage = result.Message;
            workflowNoticeClass = result.Succeeded && result.IsAvailable ? "notice-success" : "notice-error";
            if (result.Succeeded && result.IsAvailable)
            {
                project = result.Project;
                Navigation.NavigateTo($"/projects/{ProjectId}/step/2");
            }
        }
        catch (IntegrationConfigurationException exception)
        {
            workflowMessage = $"{exception.Message} Mở Cài đặt để bổ sung credential.";
            workflowNoticeClass = "notice-error";
        }
        catch (ExternalServiceException exception)
        {
            workflowMessage = exception.Message;
            workflowNoticeClass = "notice-error";
        }
        finally
        {
            isNavigating = false;
        }
    }

    private GeneralInfoDraft CreateDraft() =>
        new(internalName, inputFile, outputFile, timeLimitMs, memoryLimitMb);

    private bool HasIssue(string field) => validationIssues.Any(issue => issue.Field == field);
    private string? GetIssue(string field) => validationIssues.FirstOrDefault(issue => issue.Field == field)?.Message;

    public void Dispose()
    {
        autosaveCancellation?.Cancel();
        autosaveCancellation?.Dispose();
    }

    private static string GetStepDescription(int step) => step switch
    {
        1 => "Cấu hình năm trường thông tin chung trước khi kiểm tra tên trên Polygon.",
        2 => "Trao đổi với OpenAI hoặc Gemini trong một conversation duy nhất của dự án.",
        3 => "Chỉnh sửa đúng năm trường statement và xem preview Polygon-compatible LaTeX.",
        4 => "Tạo, chỉnh sửa và compile solution.cpp cùng generate.cpp bằng GNU C++17.",
        5 => "Kiểm tra checker, script, Sample 1 và chủ động đồng bộ lên Polygon.",
        _ => string.Empty,
    };

    private static string GetPlaceholderTitle(int step) => step switch
    {
        2 => "AI workspace đang được nối provider",
        3 => "Statement editor đang được chuẩn bị",
        4 => "Code workspace đang được chuẩn bị",
        5 => "Tests & Sync đang được chuẩn bị",
        _ => "Đang chuẩn bị",
    };
}
