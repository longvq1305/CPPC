@page "/settings"
@inject ISettingsService SettingsService
@inject IPolygonClient PolygonClient
@inject IModelCatalogService ModelCatalog
@inject IToolchainService ToolchainService
@inject IConnectionDiagnosticsService ConnectionDiagnostics
@inject PolygonAiBuilder.Infrastructure.RuntimePaths Paths

<PageTitle>Cài đặt · Polygon AI Builder</PageTitle>

<header class="page-header compact-header">
    <div>
        <span class="eyebrow">Configuration</span>
        <h1>Cài đặt</h1>
        <p>Credential được mã hóa bằng Windows DPAPI CurrentUser và không được lưu trong database.</p>
    </div>
    <div class="button-row">
        <button class="btn btn-secondary" @onclick="OpenLogsFolder">Open logs folder</button>
        <button class="btn btn-primary app-primary" @onclick="SaveAsync" disabled="@(isBusy || isLoading)">
            @(isBusy ? "Đang lưu…" : "Lưu thay đổi")
        </button>
    </div>
</header>

@if (isLoading)
{
    <div class="loading-card"><span class="spinner-border spinner-border-sm"></span> Đang đọc cài đặt đã mã hóa…</div>
}
else
{
    @if (!string.IsNullOrWhiteSpace(statusMessage))
    {
        <div class="notice @(saveSucceeded ? "notice-success" : "notice-error")" role="status">@statusMessage</div>
    }

    <div class="settings-grid">
        <section class="panel settings-card">
            <div class="settings-title">
                <span class="provider-logo openai-logo">O</span>
                <div><h2>OpenAI</h2><p>Responses API</p></div>
                <span class="status-pill @(snapshot.HasOpenAiApiKey ? "success" : "neutral")">
                    @(snapshot.HasOpenAiApiKey ? "Đã lưu key" : "Chưa cấu hình")
                </span>
            </div>
            <label for="openai-key">API key</label>
            <input id="openai-key" type="password" class="form-control" autocomplete="new-password"
                   placeholder="@(snapshot.HasOpenAiApiKey ? snapshot.OpenAiMasked : "sk-…")" @bind="openAiApiKey" />
            <div class="form-check clear-check">
                <input id="clear-openai" class="form-check-input" type="checkbox" @bind="clearOpenAiApiKey" />
                <label class="form-check-label" for="clear-openai">Xóa key đã lưu</label>
            </div>
            <label for="openai-model">Model mặc định</label>
            <input id="openai-model" class="form-control" maxlength="200" list="openai-models"
                   placeholder="Refresh models hoặc nhập model ID" @bind="openAiDefaultModel" />
            <datalist id="openai-models">
                @foreach (var model in openAiModels)
                {
                    <option value="@model.Id">@model.DisplayName</option>
                }
            </datalist>
            <div class="button-row">
                <button class="btn btn-secondary" @onclick="() => RefreshModelsAsync(AiProviderKind.OpenAI)"
                        disabled="@(isBusy || !snapshot.HasOpenAiApiKey)">
                    @(isRefreshingOpenAi ? "Đang tải…" : "Refresh models")
                </button>
                <button class="btn btn-secondary" @onclick="() => TestAiAsync(AiProviderKind.OpenAI)"
                        disabled="@(isBusy || !snapshot.HasOpenAiApiKey)">Test connection</button>
            </div>
            @if (!string.IsNullOrWhiteSpace(openAiTestMessage))
            {
                <p class="connection-result @(openAiTestSucceeded ? "success" : "failed")" role="status">@openAiTestMessage</p>
            }
        </section>

        <section class="panel settings-card">
            <div class="settings-title">
                <span class="provider-logo gemini-logo">G</span>
                <div><h2>Gemini</h2><p>Interactions API</p></div>
                <span class="status-pill @(snapshot.HasGeminiApiKey ? "success" : "neutral")">
                    @(snapshot.HasGeminiApiKey ? "Đã lưu key" : "Chưa cấu hình")
                </span>
            </div>
            <label for="gemini-key">API key</label>
            <input id="gemini-key" type="password" class="form-control" autocomplete="new-password"
                   placeholder="@(snapshot.HasGeminiApiKey ? snapshot.GeminiMasked : "Nhập API key")" @bind="geminiApiKey" />
            <div class="form-check clear-check">
                <input id="clear-gemini" class="form-check-input" type="checkbox" @bind="clearGeminiApiKey" />
                <label class="form-check-label" for="clear-gemini">Xóa key đã lưu</label>
            </div>
            <label for="gemini-model">Model mặc định</label>
            <input id="gemini-model" class="form-control" maxlength="200" list="gemini-models"
                   placeholder="Refresh models hoặc nhập model ID" @bind="geminiDefaultModel" />
            <datalist id="gemini-models">
                @foreach (var model in geminiModels)
                {
                    <option value="@model.Id">@model.DisplayName</option>
                }
            </datalist>
            <div class="button-row">
                <button class="btn btn-secondary" @onclick="() => RefreshModelsAsync(AiProviderKind.Gemini)"
                        disabled="@(isBusy || !snapshot.HasGeminiApiKey)">
                    @(isRefreshingGemini ? "Đang tải…" : "Refresh models")
                </button>
                <button class="btn btn-secondary" @onclick="() => TestAiAsync(AiProviderKind.Gemini)"
                        disabled="@(isBusy || !snapshot.HasGeminiApiKey)">Test connection</button>
            </div>
            @if (!string.IsNullOrWhiteSpace(geminiTestMessage))
            {
                <p class="connection-result @(geminiTestSucceeded ? "success" : "failed")" role="status">@geminiTestMessage</p>
            }
        </section>

        <section class="panel settings-card">
            <div class="settings-title">
                <span class="provider-logo polygon-logo">P</span>
                <div><h2>Polygon</h2><p>Codeforces Polygon API</p></div>
                <span class="status-pill @(snapshot.HasPolygonApiKey && snapshot.HasPolygonApiSecret ? "success" : "neutral")">
                    @(snapshot.HasPolygonApiKey && snapshot.HasPolygonApiSecret ? "Đã lưu credential" : "Chưa cấu hình")
                </span>
            </div>
            <label for="polygon-key">API key</label>
            <input id="polygon-key" type="password" class="form-control" autocomplete="new-password"
                   placeholder="@(snapshot.HasPolygonApiKey ? snapshot.PolygonApiKeyMasked : "Nhập API key")" @bind="polygonApiKey" />
            <div class="form-check clear-check">
                <input id="clear-polygon-key" class="form-check-input" type="checkbox" @bind="clearPolygonApiKey" />
                <label class="form-check-label" for="clear-polygon-key">Xóa API key đã lưu</label>
            </div>
            <label for="polygon-secret">API secret</label>
            <input id="polygon-secret" type="password" class="form-control" autocomplete="new-password"
                   placeholder="@(snapshot.HasPolygonApiSecret ? snapshot.PolygonApiSecretMasked : "Nhập API secret")" @bind="polygonApiSecret" />
            <div class="form-check clear-check">
                <input id="clear-polygon-secret" class="form-check-input" type="checkbox" @bind="clearPolygonApiSecret" />
                <label class="form-check-label" for="clear-polygon-secret">Xóa API secret đã lưu</label>
            </div>
            <div class="button-row">
                <button class="btn btn-secondary" @onclick="TestPolygonAsync"
                        disabled="@(isBusy || !snapshot.HasPolygonApiKey || !snapshot.HasPolygonApiSecret)">
                    @(isTestingPolygon ? "Đang kiểm tra…" : "Test connection")
                </button>
            </div>
            @if (!string.IsNullOrWhiteSpace(polygonTestMessage))
            {
                <p class="connection-result @(polygonTestSucceeded ? "success" : "failed")" role="status">@polygonTestMessage</p>
            }
        </section>

        <section class="panel settings-card toolchain-card">
            <div class="settings-title">
                <span class="provider-logo toolchain-logo">C++</span>
                <div><h2>Local toolchain</h2><p>GNU C++17 · bundled</p></div>
                <span class="status-pill @ToolchainStatusClass">@ToolchainStatusLabel</span>
            </div>
            <dl class="status-list">
                <div><dt>Compiler</dt><dd>@(toolchainStatus?.CompilerVersion ?? "Chưa xác minh")</dd></div>
                <div><dt>GNU C++17</dt><dd>@ReadyText(toolchainStatus?.SupportsGnuCpp17)</dd></div>
                <div><dt>testlib.h</dt><dd>@ReadyText(toolchainStatus?.HasTestlib)</dd></div>
                <div><dt>Checker source</dt><dd>@ReadyText(toolchainStatus is { HasNcmp: true, HasWcmp: true })</dd></div>
            </dl>
            <div class="button-row">
                <button class="btn btn-secondary" @onclick="VerifyToolchainAsync" disabled="@isToolchainBusy">Verify toolchain</button>
                <button class="btn btn-secondary" @onclick="RepairToolchainAsync" disabled="@isToolchainBusy">
                    @(isRepairingToolchain ? "Đang tải/xác minh…" : "Repair toolchain")
                </button>
            </div>
            @if (!string.IsNullOrWhiteSpace(toolchainMessage))
            {
                <p class="connection-result @(toolchainStatus?.IsReady == true ? "success" : "failed")" role="status">@toolchainMessage</p>
            }
            <p class="security-note">Ứng dụng sẽ không chạy code đính kèm. Code trong editor chỉ chạy sau cảnh báo rõ ràng.</p>
        </section>
    </div>
}

@code {
    private SettingsSnapshot snapshot = new(false, false, false, false, "", "", "", "", "", "");
    private string? openAiApiKey;
    private string? geminiApiKey;
    private string? polygonApiKey;
    private string? polygonApiSecret;
    private string openAiDefaultModel = string.Empty;
    private string geminiDefaultModel = string.Empty;
    private bool clearOpenAiApiKey;
    private bool clearGeminiApiKey;
    private bool clearPolygonApiKey;
    private bool clearPolygonApiSecret;
    private bool isLoading = true;
    private bool isBusy;
    private bool isTestingPolygon;
    private bool isRefreshingOpenAi;
    private bool isRefreshingGemini;
    private IReadOnlyList<AiModelInfo> openAiModels = [];
    private IReadOnlyList<AiModelInfo> geminiModels = [];
    private bool openAiTestSucceeded;
    private bool geminiTestSucceeded;
    private string? openAiTestMessage;
    private string? geminiTestMessage;
    private bool polygonTestSucceeded;
    private string? polygonTestMessage;
    private bool saveSucceeded;
    private string? statusMessage;
    private ToolchainStatus? toolchainStatus;
    private string? toolchainMessage;
    private bool isToolchainBusy;
    private bool isRepairingToolchain;

    private string ToolchainStatusClass => toolchainStatus?.IsReady == true ? "success" : toolchainStatus is null ? "neutral" : "warning";
    private string ToolchainStatusLabel => toolchainStatus?.IsReady == true ? "Sẵn sàng" : toolchainStatus is null ? "Chưa xác minh" : "Cần repair";

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true;
        try
        {
            snapshot = await SettingsService.LoadAsync();
            openAiDefaultModel = snapshot.OpenAiDefaultModel;
            geminiDefaultModel = snapshot.GeminiDefaultModel;
            if (snapshot.HasOpenAiApiKey)
            {
                openAiModels = await ModelCatalog.GetModelsAsync(AiProviderKind.OpenAI, refresh: false);
            }
            if (snapshot.HasGeminiApiKey)
            {
                geminiModels = await ModelCatalog.GetModelsAsync(AiProviderKind.Gemini, refresh: false);
            }
            await VerifyToolchainAsync();
        }
        catch (Exception)
        {
            statusMessage = "Không thể đọc cài đặt đã mã hóa. Hãy kiểm tra quyền truy cập thư mục data.";
            saveSucceeded = false;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SaveAsync()
    {
        isBusy = true;
        statusMessage = null;
        try
        {
            await SettingsService.SaveAsync(new(
                openAiApiKey,
                clearOpenAiApiKey,
                geminiApiKey,
                clearGeminiApiKey,
                polygonApiKey,
                clearPolygonApiKey,
                polygonApiSecret,
                clearPolygonApiSecret,
                openAiDefaultModel,
                geminiDefaultModel));
            saveSucceeded = true;
            statusMessage = "Đã lưu cài đặt. Credential được mã hóa bằng DPAPI CurrentUser.";
            ResetSecretInputs();
            snapshot = await SettingsService.LoadAsync();
        }
        catch (Exception)
        {
            saveSucceeded = false;
            statusMessage = "Không thể lưu cài đặt. Credential cũ vẫn được giữ nguyên.";
        }
        finally
        {
            isBusy = false;
        }
    }

    private void ResetSecretInputs()
    {
        openAiApiKey = null;
        geminiApiKey = null;
        polygonApiKey = null;
        polygonApiSecret = null;
        clearOpenAiApiKey = false;
        clearGeminiApiKey = false;
        clearPolygonApiKey = false;
        clearPolygonApiSecret = false;
    }

    private async Task TestPolygonAsync()
    {
        isBusy = true;
        isTestingPolygon = true;
        polygonTestMessage = null;
        try
        {
            var result = await PolygonClient.TestConnectionAsync();
            polygonTestSucceeded = result.Succeeded;
            polygonTestMessage = $"{result.Message} ({result.Duration.TotalMilliseconds:N0} ms)";
            await ConnectionDiagnostics.RecordPolygonAsync(result.Succeeded, polygonTestMessage);
        }
        catch (IntegrationConfigurationException exception)
        {
            polygonTestSucceeded = false;
            polygonTestMessage = exception.Message;
            await ConnectionDiagnostics.RecordPolygonAsync(false, exception.Message);
        }
        catch (ExternalServiceException exception)
        {
            polygonTestSucceeded = false;
            polygonTestMessage = exception.Message;
            await ConnectionDiagnostics.RecordPolygonAsync(false, exception.Message);
        }
        finally
        {
            isTestingPolygon = false;
            isBusy = false;
        }
    }

    private async Task RefreshModelsAsync(AiProviderKind provider)
    {
        isBusy = true;
        isRefreshingOpenAi = provider == AiProviderKind.OpenAI;
        isRefreshingGemini = provider == AiProviderKind.Gemini;
        try
        {
            var models = await ModelCatalog.GetModelsAsync(provider, refresh: true);
            if (provider == AiProviderKind.OpenAI)
            {
                openAiModels = models;
                openAiTestSucceeded = true;
                openAiTestMessage = $"Đã tải {models.Count} model chat từ OpenAI.";
                await ConnectionDiagnostics.RecordAiAsync(AiProviderKind.OpenAI, true, openAiTestMessage);
            }
            else
            {
                geminiModels = models;
                geminiTestSucceeded = true;
                geminiTestMessage = $"Đã tải {models.Count} model chat từ Gemini.";
                await ConnectionDiagnostics.RecordAiAsync(AiProviderKind.Gemini, true, geminiTestMessage);
            }
        }
        catch (Exception exception) when (exception is IntegrationConfigurationException or ExternalServiceException)
        {
            SetAiTestResult(provider, false, exception.Message);
            await ConnectionDiagnostics.RecordAiAsync(provider, false, exception.Message);
        }
        finally
        {
            isRefreshingOpenAi = false;
            isRefreshingGemini = false;
            isBusy = false;
        }
    }

    private async Task TestAiAsync(AiProviderKind provider)
    {
        isBusy = true;
        try
        {
            var result = await ModelCatalog.TestConnectionAsync(provider);
            var message = $"{result.Message} ({result.Duration.TotalMilliseconds:N0} ms)";
            SetAiTestResult(provider, result.Succeeded, message);
            await ConnectionDiagnostics.RecordAiAsync(provider, result.Succeeded, message);
        }
        catch (Exception exception) when (exception is IntegrationConfigurationException or ExternalServiceException)
        {
            SetAiTestResult(provider, false, exception.Message);
            await ConnectionDiagnostics.RecordAiAsync(provider, false, exception.Message);
        }
        finally
        {
            isBusy = false;
        }
    }

    private void SetAiTestResult(AiProviderKind provider, bool succeeded, string message)
    {
        if (provider == AiProviderKind.OpenAI)
        {
            openAiTestSucceeded = succeeded;
            openAiTestMessage = message;
        }
        else
        {
            geminiTestSucceeded = succeeded;
            geminiTestMessage = message;
        }
    }

    private async Task VerifyToolchainAsync()
    {
        isToolchainBusy = true;
        try
        {
            toolchainStatus = await ToolchainService.VerifyAsync();
            toolchainMessage = toolchainStatus.Message;
            if (toolchainStatus.Issues.Count > 0)
            {
                toolchainMessage += " " + string.Join(" ", toolchainStatus.Issues);
            }
        }
        catch (Exception exception) when (exception is IOException or InvalidDataException)
        {
            toolchainMessage = exception.Message;
        }
        finally
        {
            isToolchainBusy = false;
        }
    }

    private async Task RepairToolchainAsync()
    {
        isToolchainBusy = isRepairingToolchain = true;
        toolchainMessage = "Đang tải và xác minh toolchain đã pin. Lần đầu có thể mất vài phút…";
        try
        {
            toolchainStatus = await ToolchainService.RepairAsync();
            toolchainMessage = toolchainStatus.Message;
        }
        catch (Exception exception) when (exception is HttpRequestException or IOException or InvalidDataException)
        {
            toolchainMessage = $"Repair toolchain thất bại: {exception.Message}";
        }
        finally
        {
            isToolchainBusy = isRepairingToolchain = false;
        }
    }

    private void OpenLogsFolder()
    {
        try
        {
            Directory.CreateDirectory(Paths.LogsPath);
            using var process = System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo
            {
                FileName = Paths.LogsPath,
                UseShellExecute = true,
            });
            statusMessage = process is null
                ? "Windows không thể mở thư mục logs. Đường dẫn được hiển thị ở Diagnostics."
                : "Đã yêu cầu Windows mở thư mục logs.";
            saveSucceeded = process is not null;
        }
        catch (Exception exception) when (exception is System.ComponentModel.Win32Exception or InvalidOperationException or IOException)
        {
            statusMessage = $"Không thể mở thư mục logs: {exception.Message}";
            saveSucceeded = false;
        }
    }

    private static string ReadyText(bool? ready) => ready == true ? "OK" : ready == false ? "Thiếu/lỗi" : "Chưa kiểm tra";
}
